# This diagnostic branch builds instrumented copies, leaving the baseline source
# files untouched. Everything is generated by CMake; Python is NOT required.
option(ORCA_PICKER_DIAGNOSTICS "Build picker stall diagnostics" ON)
if(NOT ORCA_PICKER_DIAGNOSTICS)
    return()
endif()

function(pd_replace old new)
    string(FIND "${pd_text}" "${old}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Picker diagnostics anchor missing in ${pd_name}: ${old}")
    endif()
    string(LENGTH "${old}" old_length)
    math(EXPR after_position "${position}+${old_length}")
    string(SUBSTRING "${pd_text}" ${after_position} -1 remainder)
    string(FIND "${remainder}" "${old}" duplicate)
    if(NOT duplicate EQUAL -1)
        message(FATAL_ERROR "Picker diagnostics ambiguous replacement in ${pd_name}: ${old}")
    endif()
    string(REPLACE "${old}" "${new}" pd_text "${pd_text}")
    set(pd_text "${pd_text}" PARENT_SCOPE)
endfunction()
function(pd_optional_replace old new)
    string(REPLACE "${old}" "${new}" pd_text "${pd_text}")
    set(pd_text "${pd_text}" PARENT_SCOPE)
endfunction()
function(pd_entry signature instrumentation)
    string(FIND "${pd_text}" "${signature}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "Picker diagnostics function missing in ${pd_name}: ${signature}")
    endif()
    string(LENGTH "${signature}" signature_length)
    math(EXPR tail_start "${position}+${signature_length}")
    string(SUBSTRING "${pd_text}" ${tail_start} -1 tail)
    string(FIND "${tail}" "${signature}" duplicate)
    if(NOT duplicate EQUAL -1)
        message(FATAL_ERROR "Picker diagnostics ambiguous function in ${pd_name}: ${signature}")
    endif()
    string(FIND "${tail}" "{" body)
    string(FIND "${tail}" ";" declaration)
    if(body EQUAL -1 OR (NOT declaration EQUAL -1 AND declaration LESS body))
        message(FATAL_ERROR "Picker diagnostics expected function body: ${signature}")
    endif()
    math(EXPR insertion "${tail_start}+${body}+1")
    string(SUBSTRING "${pd_text}" 0 ${insertion} before)
    string(SUBSTRING "${pd_text}" ${insertion} -1 after)
    set(pd_text "${before}\n${instrumentation}${after}" PARENT_SCOPE)
endfunction()

# Scope replacements to a known pair of neighboring definitions. This prevents
# an identical statement in a thumbnail/highlight path acquiring frame locals.
function(pd_region_replace start_signature end_signature old new)
    string(FIND "${pd_text}" "${start_signature}" begin)
    if(begin EQUAL -1)
        message(FATAL_ERROR "Picker diagnostics region start missing: ${start_signature}")
    endif()
    string(SUBSTRING "${pd_text}" ${begin} -1 rest)
    string(FIND "${rest}" "${end_signature}" length)
    if(length EQUAL -1)
        message(FATAL_ERROR "Picker diagnostics region end missing: ${end_signature}")
    endif()
    math(EXPR end "${begin}+${length}")
    string(SUBSTRING "${pd_text}" 0 ${begin} prefix)
    string(SUBSTRING "${pd_text}" ${end} -1 suffix)
    string(SUBSTRING "${rest}" 0 ${length} pd_text)
    pd_replace("${old}" "${new}")
    set(pd_text "${prefix}${pd_text}${suffix}" PARENT_SCOPE)
endfunction()
function(pd_render_replace old new)
    pd_region_replace("void GLCanvas3D::render(bool only_init, bool overlayOnly)" "void GLCanvas3D::render_thumbnail(" "${old}" "${new}")
    set(pd_text "${pd_text}" PARENT_SCOPE)
endfunction()
function(pd_pick_draw_replace old new)
    pd_region_replace("bool GLCanvas3D::_render_volumes_for_picking(" "void GLCanvas3D::_render_current_gizmo(" "${old}" "${new}")
    set(pd_text "${pd_text}" PARENT_SCOPE)
endfunction()
function(pd_query_replace old new)
    pd_region_replace("GLCanvas3D::VolumePickResult GLCanvas3D::QueryVolumeFromPickingBuffer(" "GLCanvas3D::PickingPassResult GLCanvas3D::QueryHybridPickingHit(" "${old}" "${new}")
    set(pd_text "${pd_text}" PARENT_SCOPE)
endfunction()

set(pd_directory "${CMAKE_CURRENT_LIST_DIR}")
set(pd_output "${CMAKE_CURRENT_BINARY_DIR}/picker-diagnostics")
file(MAKE_DIRECTORY "${pd_output}")
get_target_property(pd_sources libslic3r_gui SOURCES)
foreach(pd_name GLCanvas3D GLPickingBuffer GLModel 3DScene)
    set(pd_original "${pd_directory}/${pd_name}.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${pd_original}")
    file(READ "${pd_original}" pd_text)
    string(REPLACE "\r\n" "\n" pd_text "${pd_text}")
    if(pd_name STREQUAL "GLPickingBuffer")
        pd_replace([=[#include "GLPickingBuffer.hpp"]=] [=[#include "GLPickingBuffer.hpp"
#include "PickerDiagnosticsGL.hpp"]=])
    else()
        pd_replace([=[#include <GL/glew.h>]=] [=[#include <GL/glew.h>
#include "PickerDiagnosticsGL.hpp"]=])
    endif()
    include("${pd_directory}/PickerDiagnostics-${pd_name}.cmake")
    # Only redirect existing GL calls. No additional GL calls in baseline mode,
    # except the one-time GL_ENV snapshot after a context becomes current.
    foreach(pair
        "glBufferData|buffer_data" "glReadPixels|read_pixels"
        "glDrawElements|draw_elements" "glDrawElementsInstanced|draw_elements_instanced"
        "glTexImage2D|tex_image_2d" "glRenderbufferStorage|renderbuffer_storage"
        "glRenderbufferStorageEXT|renderbuffer_storage_ext"
        "glRenderbufferStorageMultisample|renderbuffer_storage_ms"
        "glBlitFramebuffer|blit" "glBlitFramebufferEXT|blit_ext"
        "glCheckFramebufferStatus|check_framebuffer" "glCheckFramebufferStatusEXT|check_framebuffer_ext")
        string(REPLACE "|" ";" parts "${pair}")
        list(GET parts 0 original_call)
        list(GET parts 1 diagnostic_call)
        pd_optional_replace("::${original_call}(" "::Slic3r::GUI::PickerDiag::${diagnostic_call}(")
    endforeach()
    pd_optional_replace("::glGetError()" "::Slic3r::GUI::PickerDiag::observed_error(__FUNCTION__)")
    file(WRITE "${pd_output}/${pd_name}.cpp.tmp" "// Generated by PickerDiagnostics.cmake. Edit the instrumentation recipes, not this file.\n${pd_text}")
    configure_file("${pd_output}/${pd_name}.cpp.tmp" "${pd_output}/${pd_name}.cpp" COPYONLY)
    file(REMOVE "${pd_output}/${pd_name}.cpp.tmp")
    # The base target is created in this directory; both relative and absolute
    # source spellings are accepted. Keep all other source properties intact.
    set(pd_found FALSE)
    set(pd_new_sources)
    foreach(source IN LISTS pd_sources)
        if(source STREQUAL "GUI/${pd_name}.cpp" OR source STREQUAL "${pd_original}")
            set(pd_found TRUE)
            list(APPEND pd_new_sources "${pd_output}/${pd_name}.cpp")
            foreach(prop COMPILE_DEFINITIONS COMPILE_OPTIONS COMPILE_FLAGS INCLUDE_DIRECTORIES OBJECT_DEPENDS SKIP_PRECOMPILE_HEADERS SKIP_UNITY_BUILD_INCLUSION)
                get_source_file_property(value "${source}" "${prop}")
                if(NOT value STREQUAL "NOTFOUND")
                    set_source_files_properties("${pd_output}/${pd_name}.cpp" PROPERTIES "${prop}" "${value}")
                endif()
            endforeach()
        else()
            list(APPEND pd_new_sources "${source}")
        endif()
    endforeach()
    if(NOT pd_found)
        message(FATAL_ERROR "Picker diagnostics cannot find ${pd_name}.cpp in libslic3r_gui")
    endif()
    set(pd_sources "${pd_new_sources}")
endforeach()
set_property(TARGET libslic3r_gui PROPERTY SOURCES "${pd_sources}")
# Keep the standard-library-only writer separate from the application's legacy PCH.
add_library(orca_picker_diagnostics STATIC "${pd_directory}/PickerDiagnostics.cpp")
set_target_properties(orca_picker_diagnostics PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_compile_features(orca_picker_diagnostics PUBLIC cxx_std_17)
target_include_directories(libslic3r_gui PRIVATE "${pd_directory}")
find_package(Threads REQUIRED)
target_link_libraries(orca_picker_diagnostics PRIVATE Threads::Threads)
target_link_libraries(libslic3r_gui orca_picker_diagnostics)
if(WIN32)
    target_compile_definitions(orca_picker_diagnostics PRIVATE _CRT_SECURE_NO_WARNINGS)
    target_link_libraries(orca_picker_diagnostics PRIVATE Psapi)
endif()
message(STATUS "Picker diagnostics enabled; generated sources: ${pd_output}")
message(STATUS "Runtime logs default ON. ORCA_PICKER_DIAG=0 disables logging; ORCA_PICKER_DIAG_DIR selects the log directory.")
